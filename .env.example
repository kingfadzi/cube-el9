# Copy to .env and edit. compose reads this via env_file + ${VAR} substitution.

# --- Image / build knobs ---
# Lab (AlmaLinux 9) example:
#   RUNTIME_BASE_IMAGE=docker.butterflycluster.com/builder-images/almalinux9-node:22
# On-prem (RHEL 9) example:
#   RUNTIME_BASE_IMAGE=registry.onprem.example.com/builder-images/rhel9-node:22
RUNTIME_BASE_IMAGE=docker.butterflycluster.com/builder-images/almalinux9-node:22

# Cube release tag — must match a published GitHub release on $GH_REPO.
CUBE_VERSION=v1.6.44

# GitHub release base URL. Defaults to kingfadzi/cube-el9.
RELEASE_BASE_URL=https://github.com/kingfadzi/cube-el9/releases/download

# Optional proxy (leave blank for direct internet).
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# --- Cube.js runtime ---
CUBEJS_DEV_MODE=true
CUBEJS_API_SECRET=replace-me-with-a-long-random-string

# --- Data source (existing external Postgres) ---
CUBEJS_DB_TYPE=postgres
# Pick the right host pattern:
#   * Postgres on the Docker host:           host.docker.internal
#       (extra_hosts in docker-compose.yml is already wired for this)
#   * Postgres on another server:            db.internal.example.com
#   * Postgres in another compose project:   <network>:<service>
#       (also wire the network into docker-compose.yml)
CUBEJS_DB_HOST=host.docker.internal
CUBEJS_DB_PORT=5432
CUBEJS_DB_NAME=your_db_name
CUBEJS_DB_USER=your_user
CUBEJS_DB_PASS=your_password
CUBEJS_DB_SSL=false

# --- Misc ---
CUBEJS_PG_SQL_PORT=15432
CUBEJS_SCHEMA_PATH=model
# Cube Store data dir. Default is <cwd>/.cubestore (= /cube/conf/.cubestore in
# the bind-mount). Point at /cube/.cubestore to use the named volume instead.
CUBESTORE_DATA_DIR=/cube/.cubestore
